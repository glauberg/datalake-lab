*.jks
*.keystore
*.key
*.pem
*.crt
trino/keystore.p12

# Arquivos de Variáveis de Ambiente e Segredos
.env
.env.local
*.secret

# Dados Brutos e Datasets (Data Lake - preservar apenas a estrutura com .gitkeep)
data/raw/*
!data/raw/.gitkeep
*.csv
*.parquet
*.jsonl

# Arquivos Residuais e Temporários
index.html
*.log
.DS_Store
Thumbs.db
