# Ambientes Virtuais Python
.venv/
venv/
env/
ENV/

# Caches e Bytecode Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

